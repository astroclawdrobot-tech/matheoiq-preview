# Alma Fina B2B Command Hub — production/live env template
NODE_ENV=production
PORT=8787

# Required before public exposure
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_SESSION_SECRET=
ALMAFINA_PUBLIC_URL=

# Keep disabled until legal/provider/manual approval checks are completed.
# Live endpoint also requires request body: { "confirm": "SEND_LIVE_ALMAFINA" }
ALMAFINA_LIVE_SEND_ENABLED=0

# Mail transport required for test/live sends and IMAP sync
ALMAFINA_FROM_EMAIL=
ALMAFINA_FROM_NAME=ALMA FINA
ALMAFINA_REPLY_TO=
ALMAFINA_SMTP_HOST=smtp.gmail.com
ALMAFINA_SMTP_PORT=587
ALMAFINA_SMTP_USERNAME=
ALMAFINA_SMTP_PASSWORD=
ALMAFINA_SMTP_USE_TLS=1
ALMAFINA_IMAP_HOST=imap.gmail.com
ALMAFINA_IMAP_PORT=993
ALMAFINA_IMAP_USERNAME=
ALMAFINA_IMAP_PASSWORD=
ALMAFINA_IMAP_MAILBOX=INBOX

# Optional Grafana/OTel
OTEL_ENABLED=0
OTEL_SERVICE_NAME=alma-fina-b2b-command-hub
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
